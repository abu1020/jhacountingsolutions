rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Interim admin gate: verified Google sign-in with one of the two
    // partner emails. Works today without server-side provisioning.
    // TODO(P0-followup): replace with a Firebase Auth `admin` custom claim
    // (set via Admin SDK) and use `request.auth.token.admin == true` so the
    // allow-list no longer has to ship in rules/client code.
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && (request.auth.token.email == 'abu01510866@gmail.com'
            || request.auth.token.email == 'ramkj1804@gmail.com');
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidEmail(value) {
      return value is string && value.size() <= 100 && value.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }

    // Optional fields are bounded too: public writes are untrusted.
    function optionalString(data, key, maxLength) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLength);
    }
    function validProfile(data) {
      return data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 100
        && optionalString(data, 'name', 100)
        && optionalString(data, 'displayName', 100)
        && optionalString(data, 'phone', 30)
        && optionalString(data, 'company', 120)
        && optionalString(data, 'notes', 2000)
        && optionalString(data, 'desiredService', 120)
        && optionalString(data, 'photoURL', 2048)
        && optionalString(data, 'createdAt', 40)
        && optionalString(data, 'updatedAt', 40)
        && (!('requirements' in data) || (data.requirements is list && data.requirements.size() <= 20))
        && (!('onboardingComplete' in data) || data.onboardingComplete is bool)
        && (!('onboardingCompleted' in data) || data.onboardingCompleted is bool);
    }

    match /{document=**} { allow read, write: if false; }

    match /inquiries/{inquiryId} {
      allow create: if request.resource.data.keys().hasOnly(['fullName', 'company', 'email', 'phone', 'service', 'city', 'message', 'userId', 'createdAt'])
        && request.resource.data.fullName is string && request.resource.data.fullName.size() > 0 && request.resource.data.fullName.size() <= 100
        && isValidEmail(request.resource.data.email)
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 30
        && request.resource.data.service is string && request.resource.data.service.size() <= 120
        && optionalString(request.resource.data, 'company', 120)
        && optionalString(request.resource.data, 'city', 120)
        && optionalString(request.resource.data, 'message', 2000)
        && optionalString(request.resource.data, 'userId', 128)
        && optionalString(request.resource.data, 'createdAt', 40);
      allow read, update, delete: if isAdmin();
    }

    match /scopeAssessments/{assessmentId} {
      allow create: if request.resource.data.keys().hasOnly(['contactName', 'companyName', 'contactEmail', 'contactPhone', 'selectedService', 'entityType', 'annualTurnover', 'preferredCity', 'notes', 'userId', 'createdAt'])
        && request.resource.data.contactName is string && request.resource.data.contactName.size() > 0 && request.resource.data.contactName.size() <= 100
        && isValidEmail(request.resource.data.contactEmail)
        && request.resource.data.contactPhone is string && request.resource.data.contactPhone.size() <= 30
        && optionalString(request.resource.data, 'companyName', 120)
        && optionalString(request.resource.data, 'selectedService', 120)
        && optionalString(request.resource.data, 'entityType', 120)
        && optionalString(request.resource.data, 'annualTurnover', 120)
        && optionalString(request.resource.data, 'preferredCity', 120)
        && optionalString(request.resource.data, 'notes', 2000)
        && optionalString(request.resource.data, 'userId', 128)
        && optionalString(request.resource.data, 'createdAt', 40);
      allow read, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      // Entitlements and roles are never client-controlled. Existing documents
      // may retain those fields but owners cannot add, change or remove them.
      allow create: if isOwner(userId) && validProfile(request.resource.data)
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'displayName', 'phone', 'company', 'notes', 'desiredService', 'photoURL', 'createdAt', 'updatedAt', 'requirements', 'onboardingComplete', 'onboardingCompleted']);
      allow update: if isOwner(userId) && validProfile(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'name', 'displayName', 'phone', 'company', 'notes', 'desiredService', 'photoURL', 'createdAt', 'updatedAt', 'requirements', 'onboardingComplete', 'onboardingCompleted']);
      allow delete: if isAdmin();
    }

    match /accessRequests/{requestId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['uid', 'email', 'softwareId', 'softwareName', 'createdAt', 'status'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.softwareId is string && request.resource.data.softwareId.size() <= 120
        && request.resource.data.softwareName is string && request.resource.data.softwareName.size() <= 120
        && optionalString(request.resource.data, 'email', 100)
        && optionalString(request.resource.data, 'createdAt', 40);
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }
    match /crmMeta/{metaId} { allow read, write: if isAdmin(); }
  }
}
